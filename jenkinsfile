pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('Kubernetes Check') {
            steps {
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" get nodes'
            }
        }

        stage('Build Backend Image') {
            steps {
                bat 'docker build -t devops-backend:1.0 ./backend'
            }
        }

        stage('Build Frontend Image') {
            steps {
                bat 'docker build -t devops-frontend:1.0 ./frontend'
            }
        }

        stage('Build Database Image') {
            steps {
                bat 'docker build -t devops-database:1.0 ./database'
            }
        }

        stage('Verify Images') {
            steps {
                bat 'docker images'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" apply -f k8s\\namespace.yaml'
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" apply -f k8s\\database-pvc.yaml'
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" apply -f k8s\\database.yaml'
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" apply -f k8s\\backend.yaml'
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" apply -f k8s\\frontend.yaml'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" rollout status deployment/backend -n devops-3tier'
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" rollout status deployment/frontend -n devops-3tier'
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" get pods -n devops-3tier'
                bat 'kubectl --kubeconfig "C:\\Users\\shrut\\.kube\\config" get services -n devops-3tier'
            }
        }
    }
}