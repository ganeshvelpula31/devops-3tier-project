pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('docker') {
            steps {
                bat 'docker --version'
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage started...'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploy stage started...'
            }
        }
    }
}