pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build Backend Docker Image') {
            steps {
               bat 'docker build -t devops-backend:1.0 ./backend'
            }
        }
            }
    }

        stage('Test') {
            steps {
                echo 'Test stage started...'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploy stage started...'
            }
        }
    }
}